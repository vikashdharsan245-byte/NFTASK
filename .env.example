# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0

# Database
# LOCAL (works immediately):
# DATABASE_URL=sqlite:///local.db
#
# VERCEL PRODUCTION (recommended):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///local.db

# NITT email restriction
ALLOWED_EMAIL_DOMAIN=nitt.edu

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# OTP
OTP_SECRET=replace-with-another-long-random-secret
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Resend
RESEND_API_KEY=re_xxxxxxxxx
OTP_FROM=Team Inductions <no-reply@yourdomain.com>

# Seed
SEED_ON_START=1
ALLOW_SEED_ENDPOINT=0
